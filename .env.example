# Local-development example only. Keep real credentials in .env or the
# deployment environment; never commit them.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/loan_eligibility

# n8n Workflow B: matching workflow
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/match-users

# n8n Workflow C: email notification workflow
N8N_WORKFLOW_C_WEBHOOK_URL=https://your-n8n-host/webhook/workflow-c

# Optional connection-pool overrides. The defaults are Lambda-friendly.
# DB_POOL_SIZE=1
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_PRE_PING=true
# DB_ECHO=false
