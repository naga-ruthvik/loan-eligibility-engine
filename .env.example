# Local-development example only. Keep real credentials in .env or the
# deployment environment; never commit them.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/loan_eligibility

# Optional connection-pool overrides. The defaults are Lambda-friendly.
# DB_POOL_SIZE=1
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT_SECONDS=5
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_PRE_PING=true
# DB_ECHO=false
